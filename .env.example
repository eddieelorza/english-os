# English Automation – Variables de entorno
# Copia este archivo como .env en la carpeta raíz del proyecto
# NUNCA subas este archivo a git (está en .gitignore)

# ── Notion ────────────────────────────────────────────────
# Tu Notion Integration Token
# Consíguelo en: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de tu base de datos VOCABULARY MASTER
# Sácalo de la URL: notion.so/<WORKSPACE>/<AQUI>?v=...
NOTION_DB_ID=2f7fd5e5f5a980d08e59f90604551776

# Mismo ID (alias usado por algunos scripts)
VOCAB_DB_ID=2f7fd5e5f5a980d08e59f90604551776

# ID de tu base de datos Writing Practice
WRITING_DB_ID=2f8fd5e5f5a980d1afddd6044ec56c55

# ID de tu base de datos Reading Hub
READING_DB_ID=2f9fd5e5f5a98014840aca0b52f7e048

# ENGLISH SYSTEM platform (ADR-002 F1)
ENGLISH_SYSTEM_PAGE_ID=
DAILY_PLAN_DB_ID=
ROUTINE_ID=
ROUTINE_FIRE_TOKEN=
ERRORS_DB_ID=
ROUTINE_REVIEW_ID=
ROUTINE_REVIEW_TOKEN=

# Gates anti-disparo accidental (ADR-001 rev.)
MIN_SESSION_REVIEWS=10

# ── AI layer (M3) ────────────────────────────────────────
# anthropic | ollama | auto (auto prefiere Anthropic si hay key)
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5
OLLAMA_MODEL=qwen2.5:7b

# Voz (ADR-007 M8/M11)
# kokoro | say | auto
TTS_PROVIDER=auto
# tiny | base | small | medium (más grande = mejor y más lento)
WHISPER_MODEL=small

# ── Día de estudio (ADR-010 M17a) ────────────────────────
# Hora a la que empieza el día, como el rollover de Anki. Estudiar a las 00:30
# cuenta como el día anterior: sin esto, trasnochar rompe la racha y reinicia
# el cupo de palabras nuevas. No se edita desde la app — el cálculo del día se
# hace en sitios que no tienen la base abierta.
STUDY_DAY_ROLLOVER_HOUR=4
